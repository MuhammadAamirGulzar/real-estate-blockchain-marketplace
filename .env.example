# =============================================================================
# RWAChain Master Environment Configuration Template
# =============================================================================
# This file documents ALL environment variables used across the project.
# Each section (frontend, backend, blockchain) has its own .env file.
# 
# Copy this file structure to create:
# - frontend/.env
# - backend/.env  
# - blockchain/.env
# =============================================================================

# ===========================
# FRONTEND CONFIGURATION
# ===========================
# Location: frontend/.env
# Used by: Vite React app (variables must start with VITE_ to be exposed)

VITE_API_URL="http://localhost:3001/api"
VITE_BLOCKCHAIN_EXPLORER="http://localhost:8545"

# ===========================
# BACKEND CONFIGURATION
# ===========================
# Location: backend/.env
# Used by: Node.js/Express server

# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/rwachain_db"

# JWT Configuration  
JWT_SECRET="your-super-secret-jwt-key-here-change-this-in-production"

# Server Configuration
PORT=3001
NODE_ENV=development

# Blockchain Configuration
RPC_URL="http://127.0.0.1:8545"
DEPLOYER_PRIVATE_KEY="0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"
CHAIN_ID="31337"

# Contract Addresses (set after deployment)
RWA_TOKEN_ADDRESS=""
PROPERTY_NFT_ADDRESS=""
ASSET_REGISTRY_ADDRESS=""
INVESTMENT_MANAGER_ADDRESS=""
KYC_REGISTRY_ADDRESS=""
ADMIN_ADDRESS=""
FEE_COLLECTOR_ADDRESS=""

# IPFS Configuration (Pinata)
PINATA_API_KEY=""
PINATA_API_SECRET=""
PINATA_JWT_TOKEN=""

# CORS Configuration
FRONTEND_URL="http://localhost:5173"

# ===========================
# BLOCKCHAIN CONFIGURATION
# ===========================
# Location: blockchain/.env
# Used by: Foundry (Solidity deployment tool)

ETH_RPC_URL="http://127.0.0.1:8545"
ROLE_MANAGER_ADDRESS=""
REVENUE_DISTRIBUTOR_ADDRESS=""
SECONDARY_MARKET_ADDRESS=""

# Etherscan/Block Explorer
ETHERSCAN_API_KEY=""
BLOCK_EXPLORER_URL="http://localhost:8545"