# Frontend Environment Configuration - Template
# Vite will expose these variables with VITE_ prefix
# Copy this file to .env and fill in your actual values

# ============================================
# API CONFIGURATION
# ============================================
VITE_API_URL="http://localhost:3001/api"
VITE_WS_URL="ws://localhost:3001"

# ============================================
# BLOCKCHAIN CONFIGURATION
# ============================================
VITE_BLOCKCHAIN_EXPLORER="http://localhost:8545"
VITE_CHAIN_ID="31337"
VITE_CHAIN_NAME="Localhost"
VITE_RPC_URL="http://127.0.0.1:8545"

# For Sepolia testnet:
# VITE_CHAIN_ID="11155111"
# VITE_CHAIN_NAME="Sepolia"
# VITE_RPC_URL="https://sepolia.infura.io/v3/YOUR_INFURA_KEY"
# VITE_BLOCKCHAIN_EXPLORER="https://sepolia.etherscan.io"

# ============================================
# CONTRACT ADDRESSES (Set after deployment)
# ============================================
# Core Contracts
VITE_ROLE_MANAGER_ADDRESS=""
VITE_KYC_REGISTRY_ADDRESS=""
VITE_PROPERTY_NFT_ADDRESS=""
VITE_ASSET_REGISTRY_ADDRESS=""
VITE_RWA_TOKEN_ADDRESS=""

# Investment & Trading Contracts
VITE_INVESTMENT_MANAGER_ADDRESS=""
VITE_SECONDARY_MARKET_ADDRESS=""
VITE_FRACTIONAL_TOKEN_ADDRESS=""
VITE_REVENUE_DISTRIBUTOR_ADDRESS=""

# Multi-Currency Payment System Contracts
VITE_PRICE_ORACLE_ADDRESS=""
VITE_PAYMENT_ESCROW_ADDRESS=""
VITE_MULTI_TOKEN_PAYMENT_ADDRESS=""

# ERC-20 Token Addresses (for payments)
VITE_USDC_TOKEN_ADDRESS="0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48"
VITE_USDT_TOKEN_ADDRESS="0xdAC17F958D2ee523a2206206994597C13D831ec7"

# ============================================
# CURRENCY CONFIGURATION
# ============================================
VITE_SUPPORTED_FIAT="USD,PKR,AED,EUR,GBP"
VITE_SUPPORTED_CRYPTO="RWAP,ETH,USDC,USDT"
VITE_DEFAULT_CURRENCY="USD"
VITE_SHOW_CURRENCY_FLAGS=true
VITE_ENABLE_CURRENCY_CONVERSION=true

# ============================================
# PAYMENT CONFIGURATION
# ============================================
VITE_ENABLE_CRYPTO_PAYMENTS=true
VITE_ENABLE_BANK_TRANSFERS=true
VITE_ENABLE_STRIPE=false
VITE_ENABLE_PLAID=false
VITE_MIN_INVESTMENT_USD=100
VITE_MAX_INVESTMENT_USD=1000000
VITE_PAYMENT_STATUS_REFRESH_INTERVAL=30000  # 30 seconds
VITE_MAX_PROOF_FILE_SIZE=10485760           # 10MB
VITE_ALLOWED_PROOF_TYPES="image/jpeg,image/png,application/pdf"

# ============================================
# ORACLE CONFIGURATION
# ============================================
VITE_EXCHANGE_RATE_REFRESH_INTERVAL=300000  # 5 minutes
VITE_PROPERTY_PRICE_REFRESH_INTERVAL=300000  # 5 minutes
VITE_AUTO_REFRESH_EXCHANGE_RATES=true
VITE_AUTO_REFRESH_PROPERTY_PRICES=true

# ============================================
# IPFS CONFIGURATION
# ============================================
VITE_IPFS_GATEWAY="https://gateway.pinata.cloud/ipfs/"

# ============================= ==============
# WALLET CONFIGURATION
# ============================================
VITE_WALLETCONNECT_PROJECT_ID=""
VITE_ENABLE_METAMASK=true
VITE_ENABLE_WALLETCONNECT=true
VITE_ENABLE_COINBASE_WALLET=true

# ============================================
# UI/UX CONFIGURATION
# ============================================
VITE_DEFAULT_THEME="light"
VITE_DEFAULT_LANGUAGE="en"
VITE_DATE_FORMAT="MM/DD/YYYY"
VITE_TIME_FORMAT="12h"
VITE_NUMBER_LOCALE="en-US"

# ============================================
# FEATURE FLAGS
# ============================================
VITE_FEATURE_MULTI_CURRENCY=true
VITE_FEATURE_BANK_TRANSFERS=true
VITE_FEATURE_ORACLE_PRICING=true
VITE_FEATURE_PROPERTY_TRADING=true
VITE_FEATURE_KYC_VERIFICATION=true
VITE_FEATURE_ADMIN_DASHBOARD=true

# ============================================
# EXTERNAL SERVICES (Optional)
# ============================================
VITE_GOOGLE_MAPS_API_KEY=""
VITE_GOOGLE_ANALYTICS_ID=""
VITE_SENTRY_DSN=""
VITE_SENTRY_ENVIRONMENT="development"

# ============================================
# DEVELOPMENT / TESTING
# ============================================
VITE_DEBUG=false
VITE_MOCK_BLOCKCHAIN=false
VITE_MOCK_API=false
VITE_SHOW_DEV_TOOLS=true
VITE_ENABLE_LOGS=true
