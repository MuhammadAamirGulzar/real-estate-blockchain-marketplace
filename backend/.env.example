# Backend Environment Configuration - Template
# Copy this file to .env and fill in your actual values

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_URL="postgresql://username:password@localhost:5432/rwachain_db"

# ============================================
# JWT & AUTHENTICATION
# ============================================
JWT_SECRET="your-super-secret-jwt-key-here-change-this-in-production"
JWT_EXPIRES_IN="7d"
SESSION_SECRET="your-session-secret-change-in-production"

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# ============================================
# BLOCKCHAIN CONFIGURATION
# ============================================
# Local development
RPC_URL="http://127.0.0.1:8545"
CHAIN_ID="31337"

# Sepolia testnet (uncomment for testnet)
# RPC_URL="https://sepolia.infura.io/v3/YOUR_INFURA_KEY"
# CHAIN_ID="11155111"

# Private keys
# ⚠️  CRITICAL SECURITY WARNING ⚠️
# The key below is the well-known Anvil/Hardhat Account #0 TEST key.
# It is PUBLIC knowledge and MUST NOT be used on any real network (testnet or mainnet).
# Replace with a dedicated private key that has never held real funds.
#
# For LOCAL DEV only (Anvil):
DEPLOYER_PRIVATE_KEY="0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"
# For Testnet/Mainnet — generate a new key and set it here:
# DEPLOYER_PRIVATE_KEY="0xYOUR_REAL_PRIVATE_KEY_NEVER_COMMIT_THIS"
ADMIN_PRIVATE_KEY=""

# ============================================
# CONTRACT ADDRESSES (Set after deployment)
# ============================================
RWA_TOKEN_ADDRESS=""
PROPERTY_NFT_ADDRESS=""
ASSET_REGISTRY_ADDRESS=""
INVESTMENT_MANAGER_ADDRESS=""
KYC_REGISTRY_ADDRESS=""
ADMIN_ADDRESS=""
FEE_COLLECTOR_ADDRESS=""

# Multi-Currency Payment System Contracts
PRICE_ORACLE_ADDRESS=""
PAYMENT_ESCROW_ADDRESS=""
MULTI_TOKEN_PAYMENT_ADDRESS=""

# ERC-20 Token Addresses
USDC_TOKEN_ADDRESS="0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48"
USDT_TOKEN_ADDRESS="0xdAC17F958D2ee523a2206206994597C13D831ec7"

# ============================================
# ORACLE CONFIGURATION
# ============================================
ORACLE_UPDATE_INTERVAL=300000  # 5 minutes in milliseconds
ORACLE_CACHE_TTL=300           # 5 minutes in seconds

# Chainlink Price Feeds (Sepolia)
CHAINLINK_ETH_USD_FEED="0x694AA1769357215DE4FAC081bf1f309aDC325306"
CHAINLINK_USDC_USD_FEED="0xA2F78ab2355fe2f984D808B5CeE7FD0A93D5270E"

# ============================================
# EXTERNAL API KEYS
# ============================================
# CoinGecko (for crypto prices)
COINGECKO_API_KEY=""
COINGECKO_API_URL="https://api.coingecko.com/api/v3"

# Exchange Rate API (for fiat rates)
EXCHANGE_RATE_API_KEY=""
EXCHANGE_RATE_API_URL="https://v6.exchangerate-api.com/v6"

# ============================================
# IPFS CONFIGURATION (Pinata)
# ============================================
PINATA_API_KEY=""
PINATA_API_SECRET=""
PINATA_JWT_TOKEN=""
PINATA_GATEWAY="https://gateway.pinata.cloud/ipfs/"

# ============================================
# PAYMENT CONFIGURATION
# ============================================
PAYMENT_PROOF_EXPIRY_DAYS=7
PAYMENT_ESCROW_TIMEOUT_SECONDS=604800  # 7 days
MIN_INVESTMENT_AMOUNT_USD=100
MAX_FILE_SIZE=10485760  # 10MB
ALLOWED_FILE_TYPES="image/jpeg,image/png,application/pdf"
UPLOAD_DIR="./uploads"

# ============================================
# STRIPE INTEGRATION (Optional)
# ============================================
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_ENABLED=false

# ============================================
# PLAID INTEGRATION (Optional)
# ============================================
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"
PLAID_ENABLED=false

# ============================================
# EMAIL CONFIGURATION
# ============================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="RWA Chain <noreply@rwachain.com>"
SKIP_EMAIL_VERIFICATION=true  # Set to false in production

# ============================================
# SECURITY & RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000    # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# FEATURE FLAGS
# ============================================
FEATURE_MULTI_CURRENCY=true
FEATURE_BANK_TRANSFERS=true
FEATURE_ORACLE_PRICING=true
FEATURE_STRIPE_PAYMENTS=false
FEATURE_PLAID_VERIFICATION=false

# ============================================
# MONITORING & LOGGING
# ============================================
LOG_LEVEL="info"
DEBUG=false
